<?xml version="1.0" encoding="UTF-8"?>
<ProxyEndpoint name="default">
  <HTTPProxyConnection>
    <BasePath>/kb/v1/cache</BasePath>
  </HTTPProxyConnection>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>RC-Catalogo</Name>
        <Condition>request.verb = "GET"</Condition>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <Flows/>
  <PostFlow name="PostFlow">
    <Request/>
    <Response>
      <Step>
        <Name>RC-Catalogo</Name>
        <Condition>request.verb = "GET"</Condition>
      </Step>
      <Step>
        <Name>AM-Cabecera-Cache</Name>
      </Step>
    </Response>
  </PostFlow>
  <RouteRule name="default">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
