<?xml version="1.0" encoding="UTF-8"?>
<RaiseFault name="RF-404">
  <DisplayName>RF-404</DisplayName>
  <FaultResponse>
    <Set>
      <Payload contentType="application/json">{"error":"not_found","mensaje":"Recurso no encontrado.","peticion":"{messageid}"}</Payload>
      <StatusCode>404</StatusCode>
    </Set>
  </FaultResponse>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
