<?xml version="1.0" encoding="UTF-8"?>
<ProxyEndpoint name="default">
  <HTTPProxyConnection>
    <BasePath>/kb/v1/jwt-idp</BasePath>
  </HTTPProxyConnection>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>VJWT-IdP</Name>
      </Step>
      <Step>
        <Name>AM-Propagar-Identidad</Name>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <Flows>
    <Flow name="escritura">
      <Condition>(request.verb = "POST") or (request.verb = "PUT") or (request.verb = "DELETE")</Condition>
      <Request>
        <Step>
          <Name>RF-403-Scope</Name>
          <Condition>NOT (jwt.VJWT-IdP.decoded.claim.scope ~~ "(^| )api:escribir( |$)")</Condition>
        </Step>
      </Request>
      <Response/>
    </Flow>
  </Flows>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <FaultRules>
    <FaultRule name="jwt-invalido">
      <Condition>JWT.failed = true</Condition>
      <Step>
        <Name>AM-Error-401</Name>
      </Step>
    </FaultRule>
  </FaultRules>
  <RouteRule name="default">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
